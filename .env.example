# ============================================================================
# متغيّرات البيئة لمنصة آفاق العالمية (Afaq Global Environment Variables)
# ============================================================================
# ⚠️ هذا ملف نموذج (example). انسخه إلى .env وضع فيه قيماً حقيقية قوية.
#    ملف .env مستثنى من Git ولا يجب رفعه أبداً.
#
# 🔐 لتوليد قيمة عشوائية قوية استخدم أحد الأمرين:
#    Linux/Mac :  openssl rand -base64 48
#    Node      :  node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"

NODE_ENV=production
PORT=3000

# ----------------------------------------------------------------------------
# 1. قاعدة بيانات PostgreSQL
# ----------------------------------------------------------------------------
# ⚠️ استبدل CHANGE_ME_... بكلمة مرور عشوائية قوية. لا تستخدم قيمة هذا الملف.
DATABASE_URL=postgres://afaq_user:CHANGE_ME_STRONG_DB_PASSWORD@afaq_db:5432/afaq_db
POSTGRES_USER=afaq_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=afaq_db

# التحقق من شهادة TLS لقاعدة البيانات.
# PG_SSL=true يفعّل الاتصال المشفّر، والتحقق من الشهادة مُفعَّل افتراضياً.
# لا تُعطّل التحقق إلا في بيئة تطوير محلية موثوقة.
PG_SSL=false
# PG_SSL_REJECT_UNAUTHORIZED=false   # ← للتطوير المحلي فقط
# PG_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ----------------------------------------------------------------------------
# 2. كلمة مرور المدير الأول (إلزامية عند أول تشغيل)
# ----------------------------------------------------------------------------
# تُستخدم مرة واحدة فقط: عند أول إقلاع، إن كان حساب المدير مقفلاً بلا كلمة مرور
# تُشفَّر وتُخزَّن، ثم يمكنك تغييرها من لوحة التحكم.
# يجب أن تكون 8 أحرف على الأقل.
INITIAL_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARS

# ----------------------------------------------------------------------------
# 3. البريد الإلكتروني (Gmail SMTP)
# ----------------------------------------------------------------------------
# أنشئ App Password من: myaccount.google.com/apppasswords
GMAIL_USER=CHANGE_ME@example.com
GMAIL_APP_PASSWORD=CHANGE_ME_16_CHAR_APP_PASSWORD
ADMIN_NOTIFICATION_EMAILS=admin@example.com

# ----------------------------------------------------------------------------
# 4. تنبيهات تلغرام (اختياري)
# ----------------------------------------------------------------------------
# التوكن من @BotFather، ومعرّف المحادثة من @userinfobot
# ⚠️ هذه القيم لا تُقرأ ولا تُعدَّل من المتصفح — تُضبط هنا فقط.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----------------------------------------------------------------------------
# 5. مفاتيح إضافية (اختياري)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
