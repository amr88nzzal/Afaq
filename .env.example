# ============================================================================
# ملف متغيرات البيئة لمنصة آفاق العالمية (Afaq Global Environment Variables)
# ============================================================================
# النطاق المعتمد: afaq-global.amrodev.com

NODE_ENV=production
PORT=3000

# 1. إعدادات قاعدة بيانات PostgreSQL
DATABASE_URL=postgres://afaq_user:ChangeMeSecurePassword123@localhost:5432/afaq_db
POSTGRES_USER=afaq_user
POSTGRES_PASSWORD=ChangeMeSecurePassword123
POSTGRES_DB=afaq_db

# 2. إعدادات البريد الإلكتروني عبر Gmail SMTP
# قم بإنشاء App Password من حساب Google: myaccount.google.com/apppasswords
GMAIL_USER=admissions@afaq-global.amrodev.com
GMAIL_APP_PASSWORD=your_gmail_16_digit_app_password
ADMIN_NOTIFICATION_EMAILS=admin@amrodev.com, amr.nzzal@gmail.com

# 3. إعدادات بوت تلغرام لإشعار المدراء (Telegram Bot Alerts)
# احصل على التوكن من @BotFather على تلغرام
TELEGRAM_BOT_TOKEN=
# معرف الشات أو القناة (احصل عليه من @userinfobot)
TELEGRAM_CHAT_ID=

# 4. مفاتيح إضافية للذكاء الاصطناعي (Gemini API)
GEMINI_API_KEY=
