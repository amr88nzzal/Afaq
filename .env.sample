# ============================================================================
#  آفاق العالمية — نموذج متغيّرات البيئة
#  Afaq Global Education — Environment Variables Template
# ============================================================================
#
#  طريقة الاستخدام:
#      cp .env.sample .env
#      ثم استبدل كل قيمة تحتوي CHANGE_ME بقيمة حقيقية قوية.
#
#  ⚠️  ملف .env لا يُرفع إلى Git أبداً (مستثنى في .gitignore).
#  ⚠️  لا تضع أي قيمة حقيقية في هذا الملف — فهو نموذج عام مكشوف.
#
#  🔐 لتوليد قيمة عشوائية قوية:
#      node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
#      openssl rand -base64 48
#
# ----------------------------------------------------------------------------
#  جدول سريع
# ----------------------------------------------------------------------------
#  المتغيّر                   إلزامي؟   القيمة الافتراضية في الكود
#  -------------------------  --------  ---------------------------
#  DATABASE_URL               نعم*      لا يوجد (يعمل بالذاكرة إن غاب)
#  INITIAL_ADMIN_PASSWORD     نعم       لا يوجد (يُولَّد ويُطبع مرة واحدة)
#  NODE_ENV                   لا        development
#  PORT                       لا        3000
#  TRUST_PROXY                لا        1
#  POSTGRES_*                 نعم**     —
#  PG_SSL / PG_SSL_*          لا        false
#  GMAIL_USER                 لا        admissions@afaq-global.amrodev.com
#  GMAIL_APP_PASSWORD         لا        فارغ ⇒ وضع محاكاة بلا إرسال
#  ADMIN_NOTIFICATION_EMAILS  لا        admin@amrodev.com
#  TELEGRAM_BOT_TOKEN         لا        فارغ ⇒ لا إشعارات تلغرام
#  TELEGRAM_CHAT_ID           لا        فارغ
#  GEMINI_API_KEY             لا        فارغ
#
#  *  إن غاب DATABASE_URL يعمل النظام بالذاكرة المتكاملة المحفوظة على القرص
#     (مناسب للتطوير فقط — تُفقد البيانات عند حذف server/data/store.json).
#  ** مطلوبة فقط لخدمة PostgreSQL في docker-compose.yml.
# ============================================================================


# ----------------------------------------------------------------------------
#  1. إعدادات التشغيل العامة
# ----------------------------------------------------------------------------

# development | production
# في production: تُفعَّل كوكي الجلسة الآمنة (Secure) ويُقدَّم dist/ بدل Vite.
NODE_ENV=production

# منفذ استماع خادم Express داخل الحاوية/الجهاز.
PORT=3000

# عدد الوكلاء الموثوقين أمام الخادم (لتحديد req.ip و req.secure).
# سلسلة النشر المعتمدة: المتصفح → Cloudflare → cloudflared → nginx → الخادم
#   ⇒ 2 (nginx + cloudflared)
# تشغيل محلي مباشر بلا وكيل ⇒ اتركه 1 أو احذفه.
# ملاحظة: تحديد المعدّل لا يعتمد على هذا المتغيّر، بل على ترويسة
# CF-Connecting-IP التي تكتبها حافة Cloudflare.
TRUST_PROXY=2


# ----------------------------------------------------------------------------
#  2. قاعدة بيانات PostgreSQL
# ----------------------------------------------------------------------------

# ⚠️ استبدل CHANGE_ME_STRONG_DB_PASSWORD بكلمة مرور عشوائية قوية.
#    عند تشغيل الخدمات بـ docker-compose، اسم المضيف هو afaq_db لا localhost.
DATABASE_URL=postgres://afaq_user:CHANGE_ME_STRONG_DB_PASSWORD@afaq_db:5432/afaq_db

# تُستخدم هذه الثلاثة بواسطة حاوية postgres نفسها في docker-compose.yml،
# ويجب أن تطابق قيم DATABASE_URL أعلاه.
POSTGRES_USER=afaq_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=afaq_db


# ----------------------------------------------------------------------------
#  3. أمان اتصال قاعدة البيانات (اختياري)
# ----------------------------------------------------------------------------

# true ⇒ تشفير الاتصال بقاعدة البيانات.
# التحقق من شهادة السيرفر مُفعَّل افتراضياً (كان معطّلاً في النسخة السابقة).
PG_SSL=false

# لا تُعطّل التحقق إلا في بيئة تطوير محلية موثوقة تماماً.
# PG_SSL_REJECT_UNAUTHORIZED=true

# شهادة CA عند استخدام شهادة موقّعة ذاتياً (سطر واحد مع \n).
# PG_SSL_CA=


# ----------------------------------------------------------------------------
#  4. حساب المدير الأول  ⚠️ إلزامي عند أول تشغيل
# ----------------------------------------------------------------------------

# تُستخدم **مرة واحدة فقط**: عند أول إقلاع، إن كان حساب المدير في قاعدة
# البيانات مقفلاً بلا كلمة مرور (القيمة '!')، تُشفَّر هذه القيمة بـ scrypt
# وتُخزَّن. بعد ذلك غيّرها من لوحة التحكم.
#
# شروط: 8 أحرف على الأقل. لا تستخدم القيم القديمة (afaq2026 / admin123) —
# فقد كانت مكشوفة في المستودع العام.
INITIAL_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARS


# ----------------------------------------------------------------------------
#  5. البريد الإلكتروني عبر Gmail SMTP (اختياري)
# ----------------------------------------------------------------------------

# إن تُرك GMAIL_APP_PASSWORD فارغاً، يعمل النظام في وضع المحاكاة: تُسجَّل
# الرسائل في سجل الخادم ولا تُرسل فعلاً. الإصلاحات لا تعتمد عليه.
#
# أنشئ App Password من: myaccount.google.com/apppasswords
# (يتطلب تفعيل التحقق بخطوتين على حساب Google)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# قائمة بريدية مفصولة بفواصل تستقبل تنبيهات الطلبات الجديدة.
ADMIN_NOTIFICATION_EMAILS=


# ----------------------------------------------------------------------------
#  6. إشعارات تلغرام (اختياري)
# ----------------------------------------------------------------------------

# التوكن من @BotFather، ومعرّف المحادثة من @userinfobot.
#
# 🔒 مهم: هاتان القيمتان **لا تُقرأان ولا تُعدَّلان من المتصفح**. الخادم
# يحذفهما من استجابة GET /api/settings ويرفض كتابتهما عبر PUT. مكانهما
# الوحيد هو هذا الملف على السيرفر.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ----------------------------------------------------------------------------
#  7. مفاتيح إضافية (اختياري)
# ----------------------------------------------------------------------------

GEMINI_API_KEY=


# ============================================================================
#  قائمة تحقق قبل النشر إلى الإنتاج
# ============================================================================
#  [ ] DATABASE_URL و POSTGRES_PASSWORD يحملان كلمة مرور عشوائية قوية جديدة
#      (وليست القيمة القديمة ChangeMeSecurePassword123 المكشوفة في Git).
#  [ ] INITIAL_ADMIN_PASSWORD مضبوط وطوله 8 أحرف على الأقل.
#  [ ] TRUST_PROXY=2 عند النشر خلف Cloudflare Tunnel.
#  [ ] ملف .env غير مرصوف في Git:  git check-ignore -v .env
#  [ ] صلاحيات الملف مقصورة:      chmod 600 .env
#  [ ] كلمة مرور المدير مُغيَّرة من لوحة التحكم بعد أول دخول.
#  [ ] كل حسابات الموظفين لها كلمات مرور جديدة (القديمة مقفلة تلقائياً).
#  [ ] TELEGRAM_BOT_TOKEN مضبوط هنا فقط، ولا يُدخل من الواجهة.
# ============================================================================
